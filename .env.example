# ============================================================
#  bcdn-linkgen — environment config
#  copy to .env and fill in your own values
# ============================================================

# ---- proxies (required) ----
# residential/mobile proxies work best. comma-separated or one per line.
# format: http://user:pass@host:port
PROXIES=

# ---- captcha solvers (need at least one) ----
# capsolver is tried first, then 2captcha as a fallback.
CAPSOLVER_KEY=
CAPMONSTER_KEY=
TWOCAPTCHA_KEY=

# ---- temp email (required) ----
# smailpro API key. receives the bunny.net verification email.
SMAILPRO_KEY=

# ---- sms verification (optional) ----
# smsbower API key. only used if a phone check is triggered.
SMSBOWER_KEY=

# ---- default origin ----
# the URL your pull zones point at (the site you're mirroring).
# can be overridden per-run with --origin.
BCDN_ORIGIN=http://your-origin-server.example.com
